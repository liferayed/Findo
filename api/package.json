{
  "name": "@findo/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate",
    "seed": "node scripts/seed.js",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:llm": "jest --config jest.integration.llm.config.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/integration/"
    ]
  },
  "dependencies": {
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "supertest": "^7.0.0"
  }
}
