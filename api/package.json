  "jest": {
    "testPathIgnorePatterns": ["/node_modules/", "/test/integration/"]
  },
  "dependencies": {
    "bullmq": "^6.3.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
