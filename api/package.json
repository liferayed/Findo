{
  "name": "@findo/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate",
    "seed": "node scripts/seed.js",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
