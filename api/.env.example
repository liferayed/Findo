# When running via `make dev`/`docker compose up` (the supported local workflow), these
# values are set directly in docker-compose.yml's `api` service and this file isn't read
# at all. Kept here as a reference for the values in play, and for the rare case of running
# the api process directly outside Docker Compose.
PORT=3000
DATABASE_URL=postgres://findo:findo@localhost:5432/findo
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
