{
  "name": "findo",
  "private": true,
  "version": "0.1.0",
  "description": "Findo - modular personal finance helper (monorepo)",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "test": "npm test --workspace=api && npm test --workspace=web",
    "lint": "eslint .",
    "migrate": "npm run migrate --workspace=api",
