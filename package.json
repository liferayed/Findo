    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "smoke": "node scripts/smoke-test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.4.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
